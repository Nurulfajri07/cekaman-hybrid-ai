# Firebase web config — copy to .env and fill in from the Firebase console.
# NEVER commit a real .env file. These values are public client keys
# (they are not secrets), but keep them out of git anyway.
VITE_FIREBASE_API_KEY=PASTE_YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=PASTE_YOUR_PROJECT.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PASTE_YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=PASTE_YOUR_PROJECT.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_YOUR_SENDER_ID
VITE_FIREBASE_APP_ID=PASTE_YOUR_APP_ID

# Set to "true" on localhost so App Check uses a debug token.
# The token is printed in the browser console on first run — register it in
# Firebase console > App Check > Apps > Manage debug tokens.
# Debug tokens are accepted in #BuildHybridAI 2026 submissions.
VITE_APPCHECK_DEBUG=true

# reCAPTCHA Enterprise site key for App Check in production builds.
# Leave empty for local development (debug token is used instead).
VITE_RECAPTCHA_ENTERPRISE_KEY=
